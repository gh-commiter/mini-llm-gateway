--- mg-release/scripts/release.sh
+++ mg-release/scripts/release.sh (proposed)
@@ -145,10 +145,10 @@
 B=$(git rev-parse --verify "$C^{commit}") || fail "build commit $C unknown"
 [[ $B == $REV || $B == $(git rev-parse HEAD) ]] || fail "build revision $B is not the gate revision $REV"
 $SKILL/../../mg-build/scripts/check-binaries.sh "build/Mini Gateway.app"
