+         minigw-tui-{windows-amd64.exe,windows-arm64.exe,linux-amd64,linux-arm64} minigw-windows-{amd64,arm64}.msi THIRD-PARTY-NOTICES.md; do
   [[ -s build/release/$f ]] || fail "missing build/release/$f"
 done
 
--- mg-release/scripts/gh-release.sh
+++ mg-release/scripts/gh-release.sh (proposed)
@@ -15,7 +15,7 @@
 FILES=(Mini-Gateway-$V.dmg Mini-Gateway-$V.zip minigw.zip install.sh
        minigw-windows-amd64.exe minigw-windows-arm64.exe minigw-tray-windows-amd64.exe minigw-tray-windows-arm64.exe
        minigw-linux-amd64 minigw-linux-arm64
-       minigw-tui-windows-amd64.exe minigw-tui-windows-arm64.exe minigw-tui-linux-amd64 minigw-tui-linux-arm64 SHA256SUMS SHA256SUMS.sig)
+       minigw-tui-windows-amd64.exe minigw-tui-windows-arm64.exe minigw-tui-linux-amd64 minigw-tui-linux-arm64 THIRD-PARTY-NOTICES.md SHA256SUMS SHA256SUMS.sig)
 # MSI za Windows (build-msi.sh): obvezen, kadar ga drevo gradi (client/minigw.wxs).
 [[ -f client/minigw.wxs ]] && FILES+=(minigw-windows-amd64.msi minigw-windows-arm64.msi)
 for f in $FILES; do [[ -s build/release/$f ]] || { print -u2 "FAIL: missing build/release/$f (run release build)"; exit 1 }; done
