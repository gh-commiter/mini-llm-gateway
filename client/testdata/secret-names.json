{
  "comment": "Item names of the secrets that Go and Swift programs share. Read by client/secretstore_test.go and Tests/RouterCoreTests/SecretNamesTests.swift: change a name only together with its migration.",
  "agentLogin": "agent:<kind>",
  "agentAPIKey": "agent:<kind>:apikey",
  "upstream": "upstream:<name>",
  "windowsGatewayTarget": "minigw/gateway/",
  "secretToolAttrs": ["service", "minigw", "gateway", "<name>"],
  "gatewayKeysFile": "gateway-keys.json",
  "platformFileName": {"agent:claude": "agent_claude", "agent:codex:apikey": "agent_codex_apikey", "upstream:Mac": "upstream_Mac", "Provider.1": "Provider.1"},
  "keychain": {
    "appService": "dev.trojar.minigateway",
    "minigwService": "dev.trojar.minigateway.cli",
    "appAccounts": ["inbound-token", "router-key", "admin", "admin-secret"],
    "minigwAccounts": ["router", "router:<profile>", "device"],
    "upstreamAccount": "upstream:<name>",
    "accessGroup": null
  }
}
