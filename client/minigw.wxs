<?xml version="1.0" encoding="utf-8"?>
<!-- Namestitveni paket za Windows (wixl, brew msitools): na uporabnika, brez skrbniških pravic. Deli (Feature, tudi
     ADDLOCAL=Client,Gateway,Plugin za /passive): Client (minigw.exe, PATH; vedno), Gateway (vrednost Run z istim imenom
     in ukazom kot minigw serve install, bližnjica, minigw-tui.exe, zagon pladnja), Plugin (minigw plugin install).
     Tabele MSI ob odstranitvi pospravijo svoje; nastavitve (%AppData%\minigw) in ključi ostanejo, razen s PURGE=1
     (minigw uninstall purge). Gradi scripts/build-msi.sh, preverja scripts/msi-test.sh. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Mini Gateway" Version="$(var.Version)" Manufacturer="Mini Gateway" Language="1033"
           UpgradeCode="5B0B7C3E-6E0B-4C64-9D2C-7E1F4A8B2C10">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"/>
    <!-- Ista različica znova: zamenja prejšnjo namestitev (sicer dva vnosa v Aplikacijah in dvakrat v PATH). Izbrani
         deli ostanejo (MigrateFeatures). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer Mini Gateway is already installed."/>
    <Media Id="1" Cabinet="minigw.cab" EmbedCab="yes"/>
    <Icon Id="tray.ico" SourceFile="$(var.Icon)"/>
    <Property Id="ARPPRODUCTICON" Value="tray.ico"/>
    <!-- PURGE=1 (ali potrditveno polje ob odstranitvi): odstrani tudi nastavitve in profile. Privzeto ostanejo. -->
    <Property Id="PURGE" Secure="yes"/>
    <!-- Posodobitev nikoli ne zahteva ponovnega zagona: StopProcesses ustavi vse naše procese pred InstallValidate, zato
         ni datotek v rabi. ReallySuppress je le zadnja varovalka (ne rešitev: zadušen zagon bi pustil stari program). -->
    <Property Id="REBOOT" Value="ReallySuppress"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Mini Gateway"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Main" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Mini Gateway" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
        <File Id="minigw" Name="minigw.exe" Source="$(var.Exe)"/>
        <!-- Pladenj je isti program brez konzole: tudi brez dela Gateway, ker zažene minigw.exe za dejanja namestitve brez
             okna konzole (minigw-tray.exe msi …), in ga minigw serve install pozneje najde ob minigw.exe. -->
        <File Id="tray" Name="minigw-tray.exe" Source="$(var.Tray)"/>
        <!-- »-«: ob odstranitvi le naš del uporabniškega PATH. Brez končnega »\« (kot pathWith v serve_install.go), da
             Windows Installer vnosa, ki ga že ima (tudi od minigw serve install), ne doda še enkrat. -->
        <Environment Id="Path" Name="-PATH" Value="[LocalAppDataFolder]Programs\Mini Gateway" Part="last" Action="set" System="no" Permanent="no"/>
        <RemoveFolder Id="RemoveInstallDir" On="uninstall"/>
      </Component>
      <Component Id="Gateway" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Mini Gateway" Name="Gateway" Type="integer" Value="1" KeyPath="yes"/>
        <File Id="tui" Name="minigw-tui.exe" Source="$(var.Tui)"/>
        <!-- Kot serviceText("windows", …) v serve_install.go: serve install, status in meni pladnja ga prepoznajo. -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="MiniGatewayRouter" Type="string"
                       Value="&quot;[INSTALLDIR]minigw-tray.exe&quot; tray --config &quot;[AppDataFolder]minigw\serve.json&quot;"/>
        <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Mini Gateway" Target="[INSTALLDIR]minigw-tray.exe"
                  Arguments="tray" WorkingDirectory="INSTALLDIR" Icon="tray.ico"/>
      </Component>
      <!-- Brez datotek: vtičnik zapiše minigw plugin install (spodaj); vnos v registru le označi, da je del nameščen. -->
      <Component Id="Plugin" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Mini Gateway" Name="Plugin" Type="integer" Value="1" KeyPath="yes"/>
      </Component>
    </DirectoryRef>
    <Feature Id="Client" Title="minigw client" Level="1" Absent="disallow" Display="expand"
             Description="The minigw command, in your PATH. Always installed.">
      <ComponentRef Id="Main"/>
      <Feature Id="Gateway" Title="Gateway" Level="1"
               Description="Runs a gateway on this PC: tray icon, start at sign-in, minigw gw settings (minigw-tui).">
        <ComponentRef Id="Gateway"/>
      </Feature>
      <Feature Id="Plugin" Title="Claude Code plugin" Level="1"
               Description="Adds the minigw plugin to Claude Code (compatible with the Claude Code CLI) and points it at this minigw.">
        <ComponentRef Id="Plugin"/>
      </Feature>
    </Feature>

    <!-- Pred InstallValidate ustavi vse naše procese, da nobena datoteka ni v rabi (brez FilesInUse, Restart Managerja in
         ponovnega zagona; okni FilesInUse ostaneta le kot rezerva). Teče kopija tega paketa iz tabele Binary (pladenj,
         program brez konzole), ne nameščeni stari program, ki novih ukazov ne pozna; zato mapa kot argument. wixl ne zna
         BinaryKey z ExeCommand: tu FileKey="tray", scripts/build-msi.sh nato v tabeli CustomAction nastavi Binary (tip 66).
         CloseTray: tray quit počaka na zahteve agentov (največ 120 s), zapre pladenj (WM_CLOSE, 5 s, nato konec) in
         zapiše, ali je tekel (RestartTray). Ob odstranitvi, izklopu dela Gateway, nadgradnji in popravilu (REINSTALL); kot
         stari paket pri nadgradnji ne (drugi quit bi zapisal »ni tekel«).
         StopProcesses: nato preostali procesi iz mape namestitve (odjemalci minigw.exe, minigw-tui.exe): WM_CLOSE, 5 s,
         konec. StopTui: ob izklopu dela Gateway le minigw-tui.exe (minigw.exe ostane, odjemalci tečejo naprej). -->
    <Binary Id="stopper" SourceFile="$(var.Tray)"/>
    <CustomAction Id="CloseTray" FileKey="tray" ExeCommand="tray quit" Return="ignore" Execute="immediate"/>
    <CustomAction Id="StopProcesses" FileKey="tray" ExeCommand="tray msi stop &quot;[INSTALLDIR]&quot;" Return="ignore" Execute="immediate"/>
    <CustomAction Id="StopTui" FileKey="tray" ExeCommand="tray msi stop &quot;[INSTALLDIR]&quot; minigw-tui.exe" Return="ignore" Execute="immediate"/>
    <!-- Po namestitvi zaženi pladenj; ob prvem zagonu sam ustvari serve.json in pokaže, kje je vrstica za povezavo.
         Zastavica quiet-if-running: če že teče, brez sporočila »already running«; sicer se pladenj znova zažene prek
         Raziskovalca (okolje msiexec nima uporabnikovega trenutnega PATH). Nadgradnja: if-was-running, le če je
         pladenj tekel pred njo (quit starega paketa je zapisal, da ni). -->
    <CustomAction Id="StartTray" FileKey="tray" ExeCommand="tray --quiet-if-running --config &quot;[AppDataFolder]minigw\serve.json&quot;" Return="asyncNoWait" Impersonate="yes"/>
    <CustomAction Id="RestartTray" FileKey="tray" ExeCommand="tray --if-was-running --config &quot;[AppDataFolder]minigw\serve.json&quot;" Return="asyncNoWait" Impersonate="yes"/>
    <!-- Vtičnik: minigw plugin install|uninstall (client/plugin.go) kot uporabnik, ko so datoteke na mestu oz. preden
         izginejo. Prek minigw-tray.exe msi …: zažene minigw.exe brez okna konzole in počaka. -->
    <CustomAction Id="PluginInstall" FileKey="tray" ExeCommand="msi plugin install" Execute="deferred" Impersonate="yes" Return="ignore"/>
    <CustomAction Id="PluginUninstall" FileKey="tray" ExeCommand="msi plugin uninstall" Execute="deferred" Impersonate="yes" Return="ignore"/>
    <CustomAction Id="PluginUninstallUpgrading" FileKey="tray" ExeCommand="msi plugin uninstall --upgrading" Execute="deferred" Impersonate="yes" Return="ignore"/>
    <CustomAction Id="Purge" FileKey="tray" ExeCommand="msi uninstall --purge --yes" Execute="deferred" Impersonate="yes" Return="ignore"/>
    <!-- Vrednost Run ob odstranitvi dela Gateway ali celote izbriše tudi minigw (kot uporabnik, po RemoveRegistryValues):
         lahko jo je zapisal pladenj (Zaženi ob prijavi) ali minigw gw autostart, in ostala je (poročilo 0.5.20). Le, če
         kaže na pladenj iz mape namestitve. -->
    <CustomAction Id="RemoveRun" FileKey="tray" ExeCommand="msi run-off" Execute="deferred" Impersonate="yes" Return="ignore"/>
    <!-- Številke korakov izrecno: wixl z After/Before na druga dejanja po meri razvrsti napačno (tudi RemoveExistingProducts
         na konec). CostFinalize 1000, RemoveFiles 3500, InstallFiles 4000, InstallFinalize 6600. -->
    <InstallExecuteSequence>
      <Custom Action="CloseTray" Sequence="1001">(REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE) OR (&amp;Gateway=2 AND !Gateway=3) OR WIX_UPGRADE_DETECTED OR WIX_SAME_VERSION_UPGRADE_DETECTED OR REINSTALL</Custom>
      <Custom Action="StopProcesses" Sequence="1002">(REMOVE~="ALL" AND NOT UPGRADINGPRODUCTCODE) OR WIX_UPGRADE_DETECTED OR WIX_SAME_VERSION_UPGRADE_DETECTED OR REINSTALL</Custom>
      <Custom Action="StopTui" Sequence="1003">&amp;Gateway=2 AND !Gateway=3 AND NOT REMOVE~="ALL"</Custom>
      <Custom Action="PluginUninstall" Sequence="3401">&amp;Plugin=2 AND !Plugin=3 AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="PluginUninstallUpgrading" Sequence="3402">&amp;Plugin=2 AND !Plugin=3 AND UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="Purge" Sequence="3403">REMOVE~="ALL" AND PURGE=1 AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="RemoveRun" Sequence="3404">(REMOVE~="ALL" OR (&amp;Gateway=2 AND !Gateway=3)) AND NOT UPGRADINGPRODUCTCODE</Custom>
      <Custom Action="PluginInstall" Sequence="4001">&amp;Plugin=3</Custom>
      <Custom Action="StartTray" Sequence="6601">&amp;Gateway=3 AND NOT WIX_UPGRADE_DETECTED AND NOT WIX_SAME_VERSION_UPGRADE_DETECTED AND NOT REINSTALL</Custom>
      <!-- Nadgradnja in popravilo (REINSTALL; CloseTray ga je zaprl): pladenj znova, le če je tekel. -->
      <Custom Action="RestartTray" Sequence="6602">(&amp;Gateway=3 AND (WIX_UPGRADE_DETECTED OR WIX_SAME_VERSION_UPGRADE_DETECTED)) OR (REINSTALL AND !Gateway=3)</Custom>
    </InstallExecuteSequence>

    <!-- Okno (polni vmesnik: dvoklik na MSI, Aplikacije → Spremeni): izbira delov; ko je nameščen, še Remove s
         potrditvenim poljem PURGE. Nadgradnja brez vprašanj. /passive in /qn oken ne pokažeta (ADDLOCAL, PURGE=1).
         Odstrani v Aplikacijah (msiexec /x) je brez oken: nastavitve ostanejo. Eno okno za oboje: wixl ne zna dveh
         potrditvenih polj z isto lastnostjo (tabela CheckBox). -->
    <CustomAction Id="GatewayBoxOn" Property="GATEWAY_BOX" Value="1"/>
    <CustomAction Id="PluginBoxOn" Property="PLUGIN_BOX" Value="1"/>
    <InstallUISequence>
      <Custom Action="GatewayBoxOn" Sequence="1001">NOT Installed OR !Gateway=3</Custom>
      <Custom Action="PluginBoxOn" Sequence="1002">NOT Installed OR !Plugin=3</Custom>
      <Show Dialog="SetupDlg" Sequence="1003">NOT WIX_UPGRADE_DETECTED AND NOT WIX_SAME_VERSION_UPGRADE_DETECTED AND (NOT Installed OR (NOT RESUME AND NOT Preselected))</Show>
      <Show Dialog="ProgressDlg" Before="ExecuteAction"/>
    </InstallUISequence>
    <UIRef Id="MiniUI"/>
  </Product>
  <Fragment>
    <UI Id="MiniUI">
      <!-- Okna, ki jih Windows Installer pokaže sam (napaka 2803, če jih ni): datoteke v rabi (minigw.exe iz seje
           Claude Code, minigw-tui), sporočila o napakah (lastnost ErrorDialog) in konec (uspeh, preklic, napaka).
           Iz razširitve ui za wixl; potrebujejo pisave WixUI_Font_*. -->
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8"/>
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12"/>
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes"/>
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal"/>
      <DialogRef Id="ErrorDlg"/>
      <DialogRef Id="FilesInUse"/>
      <DialogRef Id="MsiRMFilesInUse"/>
      <DialogRef Id="FatalError"/>
      <DialogRef Id="UserExit"/>
      <DialogRef Id="ExitDialog"/>
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999"/>
      <Dialog Id="SetupDlg" Width="370" Height="250" Title="[ProductName] [ProductVersion] Setup">
        <Control Id="GatewayBox" Type="CheckBox" X="20" Y="45" Width="330" Height="28" Property="GATEWAY_BOX" CheckBoxValue="1"
                 Text="Gateway: run a gateway on this PC (tray icon, starts at sign-in, minigw gw settings)"/>
        <Control Id="PluginBox" Type="CheckBox" X="20" Y="78" Width="330" Height="28" Property="PLUGIN_BOX" CheckBoxValue="1"
                 Text="Claude Code plugin: the minigw skills, compatible with the Claude Code CLI"/>
        <Control Id="Install" Type="PushButton" X="236" Y="220" Width="56" Height="17" Default="yes" Text="Install"
                 HideCondition="Installed" ShowCondition="NOT Installed">
          <Publish Event="AddLocal" Value="Gateway" Condition="GATEWAY_BOX" Order="1"/>
          <Publish Event="Remove" Value="Gateway" Condition="NOT GATEWAY_BOX" Order="2"/>
          <Publish Event="AddLocal" Value="Plugin" Condition="PLUGIN_BOX" Order="3"/>
          <Publish Event="Remove" Value="Plugin" Condition="NOT PLUGIN_BOX" Order="4"/>
          <Publish Event="EndDialog" Value="Return" Order="5"/>
        </Control>
        <Control Id="Change" Type="PushButton" X="236" Y="220" Width="56" Height="17" Text="Change" Hidden="yes"
                 ShowCondition="Installed" HideCondition="NOT Installed">
          <Publish Event="AddLocal" Value="Gateway" Condition="GATEWAY_BOX" Order="1"/>
          <Publish Event="Remove" Value="Gateway" Condition="NOT GATEWAY_BOX" Order="2"/>
          <Publish Event="AddLocal" Value="Plugin" Condition="PLUGIN_BOX" Order="3"/>
          <Publish Event="Remove" Value="Plugin" Condition="NOT PLUGIN_BOX" Order="4"/>
          <Publish Event="EndDialog" Value="Return" Order="5"/>
        </Control>
        <Control Id="Line" Type="Line" X="20" Y="120" Width="330" Height="0" Hidden="yes" ShowCondition="Installed"/>
        <Control Id="PurgeBox" Type="CheckBox" X="20" Y="132" Width="330" Height="28" Property="PURGE" CheckBoxValue="1" Hidden="yes"
                 ShowCondition="Installed" Text="When removing: also remove settings and profiles (connections, gateway settings, keys). Otherwise they stay."/>
        <Control Id="Remove" Type="PushButton" X="20" Y="166" Width="80" Height="17" Text="Remove" Hidden="yes" ShowCondition="Installed">
          <Publish Event="Remove" Value="ALL" Order="1"/>
          <Publish Event="EndDialog" Value="Return" Order="2"/>
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="220" Width="56" Height="17" Cancel="yes" Text="Cancel">
          <Publish Event="EndDialog" Value="Exit"/>
        </Control>
        <!-- Besedilo zadnje: wixl vzame prvi kontrolnik za Control_First; ta mora biti v zanki tabulatorja (napaka 2834). -->
        <Control Id="Title" Type="Text" X="20" Y="15" Width="330" Height="20" NoPrefix="yes"
                 Text="Mini Gateway for this user. The minigw command (in your PATH) is always installed; choose what else:"/>
      </Dialog>
      <Dialog Id="ProgressDlg" Width="370" Height="100" Title="[ProductName] Setup" Modeless="yes">
        <Control Id="ActionText" Type="Text" X="20" Y="20" Width="330" Height="15" NoPrefix="yes">
          <Subscribe Event="ActionText" Attribute="Text"/>
        </Control>
        <Control Id="ProgressBar" Type="ProgressBar" X="20" Y="45" Width="330" Height="12" ProgressBlocks="yes" Text="Progress">
          <Subscribe Event="SetProgress" Attribute="Progress"/>
        </Control>
      </Dialog>
    </UI>
  </Fragment>
</Wix>
