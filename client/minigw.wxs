<?xml version="1.0" encoding="utf-8"?>
<!-- Namestitveni paket za Windows (wixl, brew msitools): na uporabnika, brez skrbniških pravic. Naredi isto kot
     minigw serve install (mapa, PATH, vrednost Run z istim imenom in ukazom, zagon pladnja), a tabele MSI to ob
     odstranitvi tudi pospravijo. Nastavitve (%AppData%\minigw) in ključi ostanejo. Gradi scripts/build-msi.sh. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="Mini Gateway" Version="$(var.Version)" Manufacturer="Mini Gateway" Language="1033"
           UpgradeCode="5B0B7C3E-6E0B-4C64-9D2C-7E1F4A8B2C10">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perUser"/>
    <!-- Ista različica znova: zamenja prejšnjo namestitev (sicer dva vnosa v Aplikacijah in dvakrat v PATH). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes" DowngradeErrorMessage="A newer Mini Gateway is already installed."/>
    <Media Id="1" Cabinet="minigw.cab" EmbedCab="yes"/>
    <Icon Id="tray.ico" SourceFile="$(var.Icon)"/>
    <Property Id="ARPPRODUCTICON" Value="tray.ico"/>
    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="LocalAppDataFolder">
        <Directory Id="ProgramsDir" Name="Programs">
          <Directory Id="INSTALLDIR" Name="Mini Gateway"/>
        </Directory>
      </Directory>
      <Directory Id="ProgramMenuFolder"/>
    </Directory>
    <DirectoryRef Id="INSTALLDIR">
      <Component Id="Main" Guid="*">
        <RegistryValue Root="HKCU" Key="Software\Mini Gateway" Name="InstallDir" Type="string" Value="[INSTALLDIR]" KeyPath="yes"/>
        <File Id="minigw" Name="minigw.exe" Source="$(var.Exe)"/>
        <File Id="tray" Name="minigw-tray.exe" Source="$(var.Tray)"/>
        <!-- Kot serviceText("windows", …) v serve_install.go: serve install, status in meni pladnja ga prepoznajo. -->
        <RegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="MiniGatewayRouter" Type="string"
                       Value="&quot;[INSTALLDIR]minigw-tray.exe&quot; tray --config &quot;[AppDataFolder]minigw\serve.json&quot;"/>
        <!-- »-«: ob odstranitvi le naš del uporabniškega PATH. Brez končnega »\« (kot pathWith v serve_install.go), da
             Windows Installer vnosa, ki ga že ima (tudi od minigw serve install), ne doda še enkrat. -->
        <Environment Id="Path" Name="-PATH" Value="[LocalAppDataFolder]Programs\Mini Gateway" Part="last" Action="set" System="no" Permanent="no"/>
        <Shortcut Id="StartMenu" Directory="ProgramMenuFolder" Name="Mini Gateway" Target="[INSTALLDIR]minigw-tray.exe"
                  Arguments="tray" WorkingDirectory="INSTALLDIR" Icon="tray.ico"/>
        <RemoveFolder Id="RemoveInstallDir" On="uninstall"/>
      </Component>
    </DirectoryRef>
    <Feature Id="All" Level="1"><ComponentRef Id="Main"/></Feature>

    <!-- Pred odstranitvijo (tudi kot stari paket pri nadgradnji) zapri pladenj: minigw-tray.exe quit (WM_CLOSE, 5 s,
         nato konec procesa, kot closeRunningTray). Pladenj je program brez konzole, zato se ne pokaže nobeno okno.
         Ob namestitvi ne: tam bi bil v mapi lahko še stari pladenj (0.5.17), ki ukaza quit ne pozna; njega zapre
         odstranitev njegovega paketa. -->
    <CustomAction Id="CloseTray" FileKey="tray" ExeCommand="quit" Return="ignore" Execute="immediate"/>
    <!-- Po namestitvi zaženi pladenj; ob prvem zagonu sam ustvari serve.json in pokaže, kje je vrstica za povezavo.
         Zastavica quiet-if-running: ista različica znova (pladenj ostane, CloseTray se ne zažene) brez sporočila »already running«. -->
    <CustomAction Id="StartTray" FileKey="tray" ExeCommand="tray --quiet-if-running --config &quot;[AppDataFolder]minigw\serve.json&quot;" Return="asyncNoWait" Impersonate="yes"/>
    <InstallExecuteSequence>
      <Custom Action="CloseTray" After="CostFinalize">REMOVE~="ALL"</Custom>
      <Custom Action="StartTray" After="InstallFinalize">NOT (REMOVE~="ALL")</Custom>
    </InstallExecuteSequence>
  </Product>
</Wix>
